# Entorno de ejecución: development, test o production. Obligatoria.
# En development y test solo se admiten orígenes CORS localhost; en production
# solo https y nunca localhost. Sin /api/v1/docs en production.
GYNFEM_ENVIRONMENT=development
# Orígenes CORS permitidos, separados por comas: esquema, host y puerto, sin
# ruta. Obligatoria. El comodín '*' está prohibido.
GYNFEM_CORS_ORIGINS=http://localhost:5173
# Nivel de log: DEBUG, INFO, WARNING o ERROR. Opcional; por defecto, INFO.
GYNFEM_LOG_LEVEL=INFO
# Directorio del modelo (.joblib, model_metadata.json y feature_ranges.json).
# Opcional; por defecto, models/. Una ruta relativa se resuelve desde la raiz
# del repositorio. Si el contrato del modelo no se verifica, la API no arranca.
GYNFEM_MODEL_DIR=models

# --- Base de datos (Supabase, Fase 9) ---------------------------------------
# NUNCA pongas aquí valores reales: van solo en tu .env, que Git ignora.
# URL de la base para la aplicación: el pooler de Supabase en modo Transaction
# (puerto 6543), con la contraseña codificada para URL. Obligatoria. En
# production se exige sslmode=require, verify-ca o verify-full.
GYNFEM_DATABASE_URL=postgresql://gynfem:cambiar@localhost:5432/gynfem
# URL de la base para el runner de migraciones (python -m app.db.migrate): el
# pooler en modo Session. La aplicación no la lee. Obligatoria para migrar.
GYNFEM_MIGRATIONS_DATABASE_URL=postgresql://gynfem:cambiar@localhost:5432/gynfem
# Conexiones mínimas y máximas del pool. Opcionales; por defecto, 1 y 5.
GYNFEM_DB_POOL_MIN_SIZE=1
# Máximo de conexiones del pool; mayor o igual que el mínimo.
GYNFEM_DB_POOL_MAX_SIZE=5
# Segundos para establecer una conexión (libpq: mínimo 2). Opcional; por defecto, 5.
GYNFEM_DB_CONNECT_TIMEOUT_S=5
# Segundos de espera por una conexión libre del pool. Opcional; por defecto, 5.
GYNFEM_DB_POOL_TIMEOUT_S=5
# Milisegundos máximos por sentencia, aplicados dentro de cada transacción.
# Opcional; por defecto, 5000.
GYNFEM_DB_STATEMENT_TIMEOUT_MS=5000
