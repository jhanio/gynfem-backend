# Entorno de ejecución: development, test o production. Obligatoria.
# En development y test solo se admiten orígenes CORS localhost; en production
# solo https y nunca localhost. Sin /api/v1/docs en production.
GYNFEM_ENVIRONMENT=development
# Orígenes CORS permitidos, separados por comas: esquema, host y puerto, sin
# ruta. Obligatoria. El comodín '*' está prohibido.
GYNFEM_CORS_ORIGINS=http://localhost:5173
# Nivel de log: DEBUG, INFO, WARNING o ERROR. Opcional; por defecto, INFO.
GYNFEM_LOG_LEVEL=INFO
